# Server
PORT=3000
NODE_ENV=production

# Security
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# STUN/TURN (use your own Coturn server or a free STUN)
# Free STUN servers work for most networks.
# For production behind strict firewalls, add a TURN server.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Domain (used for generating invite links)
APP_URL=solidarity-class.lovestoblog.com
